# Salin nilai yang sesuai ke .env melalui Webuzo; jangan gunakan file ini berisi rahasia di Git.
APP_NAME=TapakLokal
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://DOMAIN_ANDA
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_ENCRYPT=true
CACHE_STORE=redis
CACHE_PREFIX=tapaklokal_production_
QUEUE_CONNECTION=redis
PAYMENT_QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_QUEUE_RETRY_AFTER=90
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=TapakLokal
MIDTRANS_SERVER_KEY=
MIDTRANS_PRODUCTION=true
MIDTRANS_PAYMENT_METHODS=gopay,ovo,indomaret,alfamart,mandiri,bca
PLATFORM_MARKUP_BPS=1000
# Bila database yang dipasang PostgreSQL: DB_CONNECTION=pgsql dan DB_PORT=5432.
# Document root domain Webuzo harus direktori public, bukan root project.
