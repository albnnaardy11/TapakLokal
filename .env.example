APP_NAME=TapakLokal
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=tapaklokal
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Production HTTPS: APP_ENV=production, APP_DEBUG=false,
# SESSION_SECURE_COOKIE=true, SESSION_ENCRYPT=true.
SESSION_SECURE_COOKIE=false

# Wajib diisi sebelum menjalankan `php artisan db:seed --force` pertama kali di produksi.
# Buat password berbeda untuk tiap akun: minimal 12 karakter, huruf besar/kecil, angka, dan simbol.
ADMIN_SUPER_EMAIL=
ADMIN_SUPER_PASSWORD=
ADMIN_CONTENT_EMAIL=
ADMIN_CONTENT_PASSWORD=
ADMIN_OPERATIONS_EMAIL=
ADMIN_OPERATIONS_PASSWORD=
ADMIN_FINANCE_EMAIL=
ADMIN_FINANCE_PASSWORD=
ADMIN_GROWTH_EMAIL=
ADMIN_GROWTH_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
INERTIA_SSR_ENABLED=false

# Vendor menerima harga dasar; markup 1000 basis points = 10%.
PLATFORM_MARKUP_BPS=1000
PAYMENT_QUEUE_CONNECTION=database
MIDTRANS_SERVER_KEY=
MIDTRANS_PRODUCTION=false
